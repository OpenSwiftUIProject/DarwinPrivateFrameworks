import RenderBox

extension Symbols.SymbolEffectConfiguration {
    @_spi(Private) public enum Effect: Swift.Hashable {
        case pulse(Symbols.PulseSymbolEffect)
        case bounce(Symbols.BounceSymbolEffect)
        case variableColor(Symbols.VariableColorSymbolEffect)
        case scale(Symbols.ScaleSymbolEffect)
        case appear(Symbols.AppearSymbolEffect)
        case disappear(Symbols.DisappearSymbolEffect)
        case replace(Symbols.ReplaceSymbolEffect)
        case automatic(Symbols.AutomaticSymbolEffect)
        case wiggle(Symbols.WiggleSymbolEffect)
        case rotate(Symbols.RotateSymbolEffect)
        case breathe(Symbols.BreatheSymbolEffect)
        case magicReplace(Symbols.MagicReplaceSymbolEffect)

        public static func == (a: Symbols.SymbolEffectConfiguration.Effect, b: Symbols.SymbolEffectConfiguration.Effect) -> Swift.Bool
        public func hash(into hasher: inout Swift.Hasher)
        public var hashValue: Swift.Int { get }
    }

    @_spi(Private) public init(effect: Symbols.SymbolEffectConfiguration.Effect)
    @_spi(Private) public var effect: Symbols.SymbolEffectConfiguration.Effect { get set }
    @_spi(Private) public var rbAnimation: RenderBox.RBSymbolAnimation? { get }
    @_spi(Private) public var rbOptions: [RenderBox.RBSymbolAnimation.OptionKey: Any] { get }
    @_spi(Private) public func rbOptions(with options: Symbols.SymbolEffectOptions) -> [RenderBox.RBSymbolAnimation.OptionKey: Any]
}

